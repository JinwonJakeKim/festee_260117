import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    
    const user = await base44.auth.me();
    if (!user || user.role !== 'admin') {
      return Response.json({ error: 'Unauthorized - Admin only' }, { status: 401 });
    }

    const { url, maxFestivals = 20 } = await req.json();
    
    if (!url) {
      return Response.json({ 
        success: false,
        error: 'URL is required' 
      }, { status: 400 });
    }

    console.log(`[Step 1] Fetching list page: ${url}`);
    
    // 1단계: 메인 페이지에서 축제 상세 URL 추출
    let listPageHtml;
    try {
      const listPageResponse = await fetch(url, {
        headers: {
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
          'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
          'Accept-Language': 'ko-KR,ko;q=0.9,ja;q=0.8,en;q=0.7',
        }
      });
      
      if (!listPageResponse.ok) {
        return Response.json({
          success: false,
          error: `페이지를 불러올 수 없습니다 (HTTP ${listPageResponse.status})`,
          message: '올바른 URL인지 확인해주세요.'
        });
      }
      
      listPageHtml = await listPageResponse.text();
      console.log(`[Step 1] Page loaded: ${listPageHtml.length} chars`);
    } catch (fetchError) {
      return Response.json({
        success: false,
        error: '페이지를 불러오는 중 오류가 발생했습니다',
        message: fetchError.message
      });
    }
    
    console.log(`[Step 1] Extracting festival detail URLs from list page...`);
    
    // HTML 길이를 늘려서 더 많은 콘텐츠 분석
    const maxLength = 50000;
    const truncatedListHtml = listPageHtml.length > maxLength ? listPageHtml.substring(0, maxLength) : listPageHtml;
    
    // URL 베이스 파싱
    const baseUrlObj = new URL(url);
    const baseOrigin = baseUrlObj.origin;
    
    let urlExtraction;
    try {
      urlExtraction = await base44.integrations.Core.InvokeLLM({
        prompt: `
          다음은 축제/이벤트 목록 페이지의 HTML입니다.
          이 페이지에서 **실제로 표시되고 있는 모든 축제/이벤트의 상세 페이지 링크**를 추출해주세요.
          
          **매우 중요한 규칙:**
          1. 실제 축제/이벤트 목록에 있는 "더보기", "상세보기", 제목 링크 등을 찾으세요
          2. 네비게이션 메뉴, 푸터, 사이드바의 링크는 절대 포함하지 마세요
          3. 광고, 배너, 관련 링크는 제외하세요
          4. 각 축제/이벤트의 제목도 함께 추출하세요
          5. 상대 경로는 다음과 같이 절대 경로로 변환:
             - "/ko/event/123" → "${baseOrigin}/ko/event/123"
             - "../event/123" → "${baseOrigin}/event/123"
             - "event/123" → "${baseOrigin}/ko/event/123"
          6. 중복 URL은 제거하세요
          7. 최대 ${maxFestivals}개까지 추출하세요
          
          **현재 페이지 정보:**
          - Base URL: ${url}
          - Base Origin: ${baseOrigin}
          
          **예상되는 축제 예시:**
          - "아이치 항공 박물관 '글라이더를 아십니까?앉아서 체험도 할 수 있어요!'" (2025.10.25-11.03)
          
          이런 실제 이벤트들의 링크를 찾아주세요.
          
          HTML 내용:
          ${truncatedListHtml}
        `,
        response_json_schema: {
          type: "object",
          properties: {
            festival_urls: {
              type: "array",
              items: {
                type: "object",
                properties: {
                  url: { type: "string" },
                  title: { type: "string" },
                  date_text: { type: "string" },
                  confidence: { type: "number" }
                }
              }
            },
            total_found: { type: "number" },
            extraction_notes: { type: "string" }
          }
        }
      });
    } catch (llmError) {
      return Response.json({
        success: false,
        error: 'AI 분석 중 오류가 발생했습니다',
        message: llmError.message || '다시 시도해주세요.'
      });
    }
    
    console.log(`[Step 1] LLM extraction result:`, {
      total_found: urlExtraction.total_found,
      urls_count: urlExtraction.festival_urls?.length,
      notes: urlExtraction.extraction_notes
    });
    
    // URL 정규화 및 필터링
    const festivalUrls = (urlExtraction.festival_urls || [])
      .map(item => {
        let normalizedUrl = item.url;
        
        // 상대 경로를 절대 경로로 변환
        try {
          if (normalizedUrl.startsWith('//')) {
            normalizedUrl = baseUrlObj.protocol + normalizedUrl;
          } else if (normalizedUrl.startsWith('/')) {
            normalizedUrl = baseOrigin + normalizedUrl;
          } else if (!normalizedUrl.startsWith('http')) {
            normalizedUrl = new URL(normalizedUrl, url).href;
          }
        } catch (e) {
          console.error(`Failed to normalize URL: ${item.url}`, e);
          return null;
        }
        
        return {
          ...item,
          url: normalizedUrl
        };
      })
      .filter(item => item !== null)
      .filter(item => item.confidence >= 0.4) // 신뢰도 기준 더 낮춤
      .slice(0, maxFestivals);
    
    if (festivalUrls.length === 0) {
      return Response.json({
        success: false,
        error: '축제 상세 페이지 URL을 찾을 수 없습니다',
        message: `이 페이지에서 축제 정보 링크를 추출하지 못했습니다. 
        
전체 ${urlExtraction.total_found || 0}개의 링크를 찾았으나, 신뢰도 기준을 통과한 링크가 없습니다.

추출 참고사항: ${urlExtraction.extraction_notes || '없음'}

다른 URL을 시도하거나, 단일 페이지 추출 방식을 사용해주세요.`,
        festivals: [],
        debug_info: {
          total_found: urlExtraction.total_found,
          extraction_notes: urlExtraction.extraction_notes
        }
      });
    }
    
    console.log(`[Step 1] Found ${festivalUrls.length} festival URLs after filtering`);
    console.log(`[Step 1] URLs:`, festivalUrls.map(u => ({ url: u.url, title: u.title, confidence: u.confidence })));
    
    // 2단계: 각 URL에서 축제 상세 정보 추출
    const festivals = [];
    const errors = [];
    
    for (let i = 0; i < festivalUrls.length; i++) {
      const festivalUrl = festivalUrls[i];
      console.log(`[Step 2] Processing ${i + 1}/${festivalUrls.length}: ${festivalUrl.title}`);
      console.log(`[Step 2] URL: ${festivalUrl.url}`);
      
      try {
        // URL 유효성 검사
        const testResponse = await fetch(festivalUrl.url, { 
          method: 'HEAD',
          headers: {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
          }
        });
        
        if (!testResponse.ok) {
          console.log(`[Step 2] Invalid URL (${testResponse.status}): ${festivalUrl.url}`);
          errors.push({
            url: festivalUrl.url,
            error: `HTTP ${testResponse.status}`,
            title: festivalUrl.title
          });
          continue;
        }
        
        // 페이지 내용 가져오기
        const detailResponse = await fetch(festivalUrl.url, {
          headers: {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Accept-Language': 'ko-KR,ko;q=0.9,ja;q=0.8,en;q=0.7',
          }
        });
        const detailHtml = await detailResponse.text();
        
        const truncatedDetailHtml = detailHtml.length > 20000 ? detailHtml.substring(0, 20000) : detailHtml;
        
        // LLM으로 축제 정보 추출
        const extraction = await base44.integrations.Core.InvokeLLM({
          prompt: `
            다음 웹페이지에서 축제/이벤트 정보를 추출해주세요.
            
            **예상 축제 정보:**
            - 제목: ${festivalUrl.title}
            - 날짜 정보: ${festivalUrl.date_text || '확인 필요'}
            
            **추출할 정보:**
            1. 축제 이름 (한국어 + 일본어 원어명)
            2. 개최 날짜 (YYYY-MM-DD 형식)
               - "10월 25일~11월 3일" → "2025-10-25" ~ "2025-11-03"
               - 연도가 없으면 2025년으로 가정
            3. 개최 장소 (도시와 구체적 장소)
            4. GPS 좌표 (나고야 지역이면 위도: 35.18, 경도: 136.91 근처)
            5. 카테고리 (음악/문화/예술/음식/스포츠/지역축제/기타)
            6. 축제 설명 (최소 2문장, 한국어로)
            7. 입장료 (원 단위, 무료면 0)
            8. 공식 웹사이트
            9. 하이라이트 3개 이상
            10. 관련 태그 5개 이상
            11. 축제 대표 이미지 URL (절대 경로로)
            
            **중요:**
            - 날짜가 불명확하면 estimated: true로 설정
            - GPS가 없으면 나고야 중심 좌표 사용
            - 이미지 URL은 절대 경로로 변환 (base: ${festivalUrl.url})
            
            HTML 내용:
            ${truncatedDetailHtml}
          `,
          response_json_schema: {
            type: "object",
            properties: {
              name: { type: "string" },
              name_local: { type: "string" },
              start_date: { type: "string" },
              end_date: { type: "string" },
              date_estimated: { type: "boolean" },
              city: { type: "string" },
              location: { type: "string" },
              latitude: { type: "number" },
              longitude: { type: "number" },
              category: { type: "string" },
              description: { type: "string" },
              price: { type: "number" },
              website: { type: "string" },
              image_url: { type: "string" },
              highlights: { type: "array", items: { type: "string" } },
              tags: { type: "array", items: { type: "string" } },
              confidence: { type: "number" },
              missing_fields: { type: "array", items: { type: "string" } }
            }
          }
        });
        
        console.log(`[Step 2] Extraction result for ${festivalUrl.title}:`, {
          name: extraction.name,
          confidence: extraction.confidence,
          missing_fields: extraction.missing_fields
        });
        
        // 필수 필드 검증
        if (!extraction.name || !extraction.description) {
          errors.push({
            url: festivalUrl.url,
            error: 'Required fields missing (name or description)',
            title: festivalUrl.title,
            extracted: extraction.name
          });
          continue;
        }
        
        // 신뢰도 기준: 0.5 이상
        if (extraction.confidence < 0.5) {
          errors.push({
            url: festivalUrl.url,
            error: `Low confidence (${Math.round(extraction.confidence * 100)}%)`,
            title: festivalUrl.title,
            missing_fields: extraction.missing_fields
          });
          continue;
        }
        
        // 이미지 URL 처리
        let thumbnailUrl = extraction.image_url;
        if (!thumbnailUrl || thumbnailUrl.trim() === '') {
          thumbnailUrl = `https://picsum.photos/seed/${extraction.name}/800/600`;
        } else {
          try {
            const detailBaseUrl = new URL(festivalUrl.url);
            if (thumbnailUrl.startsWith('//')) {
              thumbnailUrl = detailBaseUrl.protocol + thumbnailUrl;
            } else if (thumbnailUrl.startsWith('/')) {
              thumbnailUrl = detailBaseUrl.origin + thumbnailUrl;
            } else if (!thumbnailUrl.startsWith('http')) {
              thumbnailUrl = new URL(thumbnailUrl, festivalUrl.url).href;
            }
          } catch (e) {
            console.error('Failed to process image URL:', e);
            thumbnailUrl = `https://picsum.photos/seed/${extraction.name}/800/600`;
          }
        }
        
        // 도시가 없으면 나고야로 설정
        const city = extraction.city || '나고야';
        
        const festival = {
          name: extraction.name,
          description: extraction.description,
          country: '일본',
          city: city,
          category: extraction.category || '지역축제',
          start_date: extraction.start_date || '',
          end_date: extraction.end_date || extraction.start_date || '',
          latitude: extraction.latitude || 35.18,
          longitude: extraction.longitude || 136.91,
          thumbnail_url: thumbnailUrl,
          video_url: "",
          website: extraction.website || festivalUrl.url,
          price: extraction.price || 0,
          highlights: extraction.highlights || [],
          lineup: [],
          tags: extraction.tags || [],
          star_rating: 0,
          likes_count: 0,
          catches_count: 0,
          _metadata: {
            name_local: extraction.name_local,
            date_estimated: extraction.date_estimated || false,
            source_url: festivalUrl.url,
            list_page_url: url,
            confidence: extraction.confidence,
            extracted_at: new Date().toISOString(),
            original_title: festivalUrl.title
          }
        };
        
        festivals.push(festival);
        console.log(`[Step 2] Successfully extracted: ${extraction.name}`);
        
      } catch (error) {
        console.error(`[Step 2] Error processing ${festivalUrl.url}:`, error);
        errors.push({
          url: festivalUrl.url,
          error: error.message,
          title: festivalUrl.title
        });
      }
    }
    
    console.log(`[Complete] Extracted ${festivals.length} festivals with ${errors.length} errors`);
    
    return Response.json({
      success: true,
      source_url: url,
      festivals_found: festivals.length,
      festivals: festivals,
      errors: errors,
      debug_info: {
        total_urls_found: urlExtraction.total_found,
        urls_after_filter: festivalUrls.length,
        extraction_notes: urlExtraction.extraction_notes,
        processed_urls: festivalUrls.map(u => ({ 
          url: u.url, 
          title: u.title,
          confidence: u.confidence 
        }))
      },
      message: `${festivals.length}개의 축제 정보를 추출했습니다. ${errors.length}개는 신뢰도 기준을 통과하지 못했습니다.`,
      reliability_note: festivals.length > 0 ? '모든 축제는 50% 이상의 신뢰도를 가지고 있으며, 필수 정보가 검증되었습니다.' : ''
    });
    
  } catch (error) {
    console.error('Function error:', error);
    return Response.json({ 
      success: false,
      error: error.message || '알 수 없는 오류가 발생했습니다',
      message: '다시 시도해주세요.',
      details: error.toString()
    }, { status: 500 });
  }
});