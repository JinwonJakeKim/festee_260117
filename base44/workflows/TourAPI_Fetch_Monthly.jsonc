{
  "name": "TourAPI_Fetch_Monthly",
  "description": "\ub9e4\uc6d4 1\uc77c TourAPI\uc5d0\uc11c \ub2e4\uc74c \ub2ec \uad6d\ub0b4 \ucd95\uc81c \uc6d0\ubcf8 \ub370\uc774\ud130\ub97c \uac00\uc838\uc635\ub2c8\ub2e4. (\uc608: 9\uc6d4 1\uc77c \u2192 10\uc6d4 \ub370\uc774\ud130, 12\uc6d4 1\uc77c \u2192 \ub2e4\uc74c\ud574 1\uc6d4 \ub370\uc774\ud130)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 * *",
      "one_time_date": null,
      "timezone": "Asia/Seoul",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tourapi_fetch_monthly",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "fetch_next_month": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchTourFestivals",
            "args": {
              "areaCode": "all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\ub2e4\uc74c \ub2ec \ucd95\uc81c \ub370\uc774\ud130 \uac00\uc838\uc624\uae30",
            "description": "TourAPI\uc5d0\uc11c \ub2e4\uc74c \ub2ec \uc6d0\ubcf8 \ub370\uc774\ud130 \uc800\uc7a5"
          }
        }
      }
    ]
  }
}