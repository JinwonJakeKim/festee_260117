{
  "name": "PostReport",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "\uc2e0\uace0\ub41c \uac8c\uc2dc\uae00(Post) ID"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "post",
        "gotogether"
      ],
      "default": "post",
      "description": "\uac8c\uc2dc\uae00 \uc720\ud615 (post: \uc77c\ubc18 \uac8c\uc2dc\uae00, gotogether: \uac19\uc774\uac00\uae30)"
    },
    "post_title": {
      "type": "string",
      "description": "\uc2e0\uace0\ub41c \uac8c\uc2dc\uae00 \uc81c\ubaa9 (\ucc38\uace0\uc6a9 \uc2a4\ub0c5\uc0f7)"
    },
    "post_author_email": {
      "type": "string",
      "description": "\uc2e0\uace0\ub41c \uac8c\uc2dc\uae00 \uc791\uc131\uc790 \uc774\uba54\uc77c"
    },
    "post_author_name": {
      "type": "string",
      "description": "\uc2e0\uace0\ub41c \uac8c\uc2dc\uae00 \uc791\uc131\uc790 \uc774\ub984"
    },
    "reporter_email": {
      "type": "string",
      "description": "\uc2e0\uace0\uc790 \uc774\uba54\uc77c"
    },
    "reporter_name": {
      "type": "string",
      "description": "\uc2e0\uace0\uc790 \uc774\ub984"
    },
    "reason": {
      "type": "string",
      "enum": [
        "\uc131\uc801 \ucf58\ud150\uce20",
        "\ud3ed\ub825/\ud610\uc624 \ud45c\ud604",
        "\uc2a4\ud338/\uad11\uace0",
        "\ubd88\ubc95/\uc720\ud574 \uc815\ubcf4",
        "\uac1c\uc778\uc815\ubcf4 \ub178\ucd9c",
        "\uae30\ud0c0"
      ],
      "description": "\uc2e0\uace0 \uc0ac\uc720"
    },
    "description": {
      "type": "string",
      "description": "\uc2e0\uace0 \uc0c1\uc138 \ub0b4\uc6a9 (\uc120\ud0dd)"
    },
    "status": {
      "type": "string",
      "enum": [
        "\uc811\uc218",
        "\ucc98\ub9ac\uc911",
        "\uc644\ub8cc",
        "\uae30\uac01"
      ],
      "default": "\uc811\uc218",
      "description": "\uc2e0\uace0 \ucc98\ub9ac \uc0c1\ud0dc"
    },
    "admin_memo": {
      "type": "string",
      "description": "\uad00\ub9ac\uc790 \ucc98\ub9ac \uba54\ubaa8 (\ub0b4\ubd80\uc6a9)"
    },
    "handled_by": {
      "type": "string",
      "description": "\ucc98\ub9ac\ud55c \uad00\ub9ac\uc790 \uc774\uba54\uc77c"
    },
    "handled_at": {
      "type": "string",
      "format": "date-time",
      "description": "\ucc98\ub9ac \uc644\ub8cc \uc2dc\uac04"
    }
  },
  "required": [
    "post_id",
    "post_type",
    "reporter_email",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.reporter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}