{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "\uc0ac\uc6a9\uc790 \uc5ed\ud560"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "deactivated",
        "deleted"
      ],
      "default": "active",
      "description": "\uacc4\uc815 \uc0c1\ud0dc: active(\ud65c\uc131), deactivated(\ube44\ud65c\uc131\ud654), deleted(\uc0ad\uc81c)"
    },
    "account_status_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uacc4\uc815 \uc0c1\ud0dc \ubcc0\uacbd \uc2dc\uac04"
    }
  },
  "required": [
    "account_status_updated_at"
  ]
}