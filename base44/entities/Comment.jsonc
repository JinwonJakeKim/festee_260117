{
  "name": "Comment",
  "type": "object",
  "properties": {
    "festival_id": {
      "type": "string",
      "description": "\ucd95\uc81c ID"
    },
    "post_id": {
      "type": "string",
      "description": "\uac8c\uc2dc\uae00 ID (Post/GoTogether)"
    },
    "user_email": {
      "type": "string",
      "description": "\uc791\uc131\uc790 \uc774\uba54\uc77c"
    },
    "user_name": {
      "type": "string",
      "description": "\uc791\uc131\uc790 \uc774\ub984"
    },
    "content": {
      "type": "string",
      "description": "\ub313\uae00 \ub0b4\uc6a9"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "\uc88b\uc544\uc694 \uc218"
    },
    "parent_id": {
      "type": "string",
      "description": "\ubd80\ubaa8 \ub313\uae00 ID (\ub300\ub313\uae00)"
    }
  },
  "required": [
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}