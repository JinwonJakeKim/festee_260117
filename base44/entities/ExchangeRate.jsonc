    },
    "jpy_rate": {
      "type": "number",
      "description": "1 JPY\ub2f9 KRW \ud658\uc728"
    },
    "cny_rate": {
      "type": "number",
      "description": "1 CNY\ub2f9 KRW \ud658\uc728"
    }
  },
  "required": [
    "date",
    "usd_rate",
    "jpy_rate",
    "cny_rate"
  ],
