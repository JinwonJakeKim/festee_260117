{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\ud53c\ub4dc\ubc31\uc744 \ubcf4\ub0b8 \uc0ac\uc6a9\uc790 \uc774\uba54\uc77c"
    },
    "user_name": {
      "type": "string",
      "description": "\ud53c\ub4dc\ubc31\uc744 \ubcf4\ub0b8 \uc0ac\uc6a9\uc790 \uc774\ub984"
    },
    "category": {
      "type": "string",
      "enum": [
        "\ubc84\uadf8 \ubcf4\uace0",
        "\uae30\ub2a5 \uc81c\uc548",
        "\uc77c\ubc18 \uc758\uacac",
        "\uae30\ud0c0"
      ],
      "description": "\ud53c\ub4dc\ubc31 \uce74\ud14c\uace0\ub9ac"
    },
    "subject": {
      "type": "string",
      "description": "\ud53c\ub4dc\ubc31 \uc81c\ubaa9"
    },
    "content": {
      "type": "string",
      "description": "\ud53c\ub4dc\ubc31 \ub0b4\uc6a9"
    },
    "screenshot_url": {
      "type": "string",
      "description": "\ucca8\ubd80\ub41c \uc2a4\ud06c\ub9b0\uc0f7 URL (\uc120\ud0dd \uc0ac\ud56d)"
    },
    "status": {
      "type": "string",
      "enum": [
        "\uc811\uc218",
        "\ucc98\ub9ac \uc911",
        "\uc644\ub8cc",
        "\uac70\uc808"
      ],
      "default": "\uc811\uc218",
      "description": "\ud53c\ub4dc\ubc31 \ucc98\ub9ac \uc0c1\ud0dc"
    },
    "device_info": {
      "type": "string",
      "description": "\uc0ac\uc6a9\uc790 \uae30\uae30 \uc815\ubcf4"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "\uacf5\uac1c \uc5ec\ubd80 (true: \uacf5\uac1c, false: \ube44\uacf5\uac1c)"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "\uacf5\uac10(\uc88b\uc544\uc694) \uc218"
    },
    "comments_count": {
      "type": "number",
      "default": 0,
      "description": "\ub313\uae00 \uc218"
    }
  },
  "required": [
    "user_email",
    "category",
    "subject",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}