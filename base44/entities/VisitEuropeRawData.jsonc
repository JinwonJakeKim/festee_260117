{
  "name": "VisitEuropeRawData",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "default": "visiteurope",
      "description": "\ub370\uc774\ud130 \uc18c\uc2a4 \uc2dd\ubcc4\uc790 (\ud5a5\ud6c4 \ub2e4\ub978 \uc720\ub7fd \uc18c\uc2a4 \ucd94\uac00 \ub300\ube44)"
    },
    "source_url": {
      "type": "string",
      "description": "\ucd95\uc81c \uc0c1\uc138\ud398\uc774\uc9c0 URL (visiteurope.com/event/...) - \uc911\ubcf5 \ud310\ubcc4 \ud0a4"
    },
    "source_title": {
      "type": "string",
      "description": "\uc6d0\ubcf8 \ucd95\uc81c\uba85 (\uc601\uc5b4, visiteurope.com \uc6d0\ubb38)"
    },
    "source_country": {
      "type": "string",
      "description": "\uc6d0\ubcf8 \uad6d\uac00\uba85 (\uc601\uc5b4)"
    },
    "source_city": {
      "type": "string",
      "description": "\uc6d0\ubcf8 \ub3c4\uc2dc/\uc9c0\uc5ed\uba85 (\uc601\uc5b4)"
    },
    "source_start_date": {
      "type": "string",
      "format": "date",
      "description": "\uc6d0\ubcf8 \uc2dc\uc791\uc77c (YYYY-MM-DD) - \ud398\uc774\uc9c0\uc758 time[datetime] \uc18d\uc131 \uae30\uc900"
    },
    "source_end_date": {
      "type": "string",
      "format": "date",
      "description": "\uc6d0\ubcf8 \uc885\ub8cc\uc77c (YYYY-MM-DD)"
    },
    "date_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "tentative",
        "estimated"
      ],
      "default": "confirmed",
      "description": "\ub0a0\uc9dc \uc0c1\ud0dc: confirmed(\uc0c1\uc138\ud398\uc774\uc9c0 time \uc18d\uc131\uc73c\ub85c \ud655\uc815), tentative(\ubaa9\ub85d \ud14d\uc2a4\ud2b8 \ucd94\uc815), estimated(\ud30c\uc2f1 \ucd94\uc815)"
    },
    "source_description": {
      "type": "string",
      "description": "\uc6d0\ubcf8 \uc124\uba85 (\uc601\uc5b4, HTML \ud0dc\uadf8 \uc81c\uac70)"
    },
    "source_image_url": {
      "type": "string",
      "description": "\uc6d0\ubcf8 \ub300\ud45c \uc774\ubbf8\uc9c0 URL"
    },
    "image_attribution": {
      "type": "string",
      "description": "\uc774\ubbf8\uc9c0 \uc800\uc791\uad8c/\ucd9c\ucc98 \ud45c\uae30 (alt/title\uc5d0\uc11c \ud655\uc778\ub41c \uacbd\uc6b0)"
    },
    "website": {
      "type": "string",
      "description": "\ucd95\uc81c \uacf5\uc2dd \ud648\ud398\uc774\uc9c0 (Official Website \ub9c1\ud06c, visiteurope.com \uc790\uccb4 \ub9c1\ud06c\ub294 \uc81c\uc678)"
    },
    "latitude": {
      "type": "number",
      "description": "\uc704\ub3c4 - visiteurope.com\uc774 \uc9c1\uc811 \uc81c\uacf5\ud558\uc9c0 \uc54a\ub294 \ud55c \ube44\uc6cc\ub460 (\ub3c4\uc2dc \uc911\uc2ec\uc88c\ud45c\ub85c \uc784\uc758 \ub300\uccb4\ud558\uc9c0 \uc54a\uc74c)"
    },
    "longitude": {
      "type": "number",
      "description": "\uacbd\ub3c4"
    },
    "location_status": {
      "type": "string",
      "enum": [
        "needs_verification",
        "venue_confirmed"
      ],
      "default": "needs_verification",
      "description": "\uc704\uce58\uc815\ubcf4 \ud655\uc778 \ud544\uc694 \uc5ec\ubd80 - \uc815\ud655\ud55c \uc7a5\uc18c/\uc88c\ud45c \ubbf8\ud655\uc778 \uc2dc needs_verification"
    },
    "category": {
      "type": "string",
      "description": "\ucd95\uc81c \uce74\ud14c\uace0\ub9ac (\ubcc0\ud658 \ub2e8\uacc4\uc5d0\uc11c LLM\uc73c\ub85c \ubd84\ub958)"
    },
    "extract_status": {
      "type": "string",
      "enum": [
        "pending",
        "processed",
        "failed"
      ],
      "default": "pending",
      "description": "\uc0c1\uc138\ud398\uc774\uc9c0 \ucd94\ucd9c \uc0c1\ud0dc: pending(\ubaa9\ub85d\uc5d0\uc11c \ubc1c\uacac\ub9cc \ub428/\ubbf8\ucd94\ucd9c), processed(\uc0c1\uc138 \ucd94\ucd9c \uc644\ub8cc), failed(\ucd94\ucd9c \uc2e4\ud328)"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "processed",
        "failed",
        "duplicate"
      ],
      "default": "pending",
      "description": "Festival \ubcc0\ud658 \uc0c1\ud0dc: pending(\ub300\uae30), processing(\ucc98\ub9ac\uc911), processed(Festival \ub4f1\ub85d\uc644\ub8cc), failed(\uc2e4\ud328), duplicate(\uae30\uc874 \ucd95\uc81c\uc640 \uc911\ubcf5\ub418\uc5b4 \uc2a4\ud0b5\ub428)"
    },
    "festival_id": {
      "type": "string",
      "description": "\ubcc0\ud658\ub418\uc5b4 \uc0dd\uc131/\uc5f0\uacb0\ub41c Festival \uc5d4\ud2f0\ud2f0 ID"
    },
    "error_message": {
      "type": "string",
      "description": "\ucd94\ucd9c/\ubcc0\ud658 \uc2e4\ud328 \uc2dc \uc624\ub958 \uba54\uc2dc\uc9c0"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "\uc0c1\uc138\ud398\uc774\uc9c0\ub97c \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uac00\uc838\uc628 \uc2dc\uac04 (KST)"
    },
    "create_time": {
      "type": "string",
      "format": "date-time",
      "description": "\ucd5c\ucd08 \uc0dd\uc131 \uc2dc\uac04 (KST)"
    },
    "update_time": {
      "type": "string",
      "format": "date-time",
      "description": "\ub9c8\uc9c0\ub9c9 \uc5c5\ub370\uc774\ud2b8 \uc2dc\uac04 (KST)"
    }
  },
  "required": [
    "source_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}